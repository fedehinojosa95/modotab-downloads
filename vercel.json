{
  "rewrites": [
    {
      "source": "/pos-windows",
      "destination": "/pos-windows.exe"
    },
    {
      "source": "/pos-android",
      "destination": "/android/modotab-actual.apk"
    },
    {
      "source": "/pos-mac",
      "destination": "/api/pos-mac"
    },
    {
      "source": "/t/:ref",
      "destination": "https://pos-backend-production-baed.up.railway.app/t/:ref"
    }
  ],
  "headers": [
    {
      "source": "/pos-windows",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ModoTab POS Setup.exe\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/pos-windows.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ModoTab POS Setup.exe\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/pos-android",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Modotab.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
